<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        自适应图标前景。108×108 视口里真正的可见区是中心 72dp（半径 36 的圆），圆外会被启动器裁掉。
        约束：所有图形到圆心 (54,54) 的距离必须 < 36，否则圆形 / 圆角遮罩会切边。
    -->
    <!-- 铃铛主体（中心 x=54） -->
    <path
        android:fillColor="#37474F"
        android:pathData="M54,22 C43,22 34,31 34,42 L34,62 L27,70 L81,70 L74,62 L74,42 C74,31 65,22 54,22 Z" />
    <!--
        铃舌：圆心必须与铃身同心（x=54），y=74 紧贴铃口下方，半径 6.5。
        V11.3 修正：原为 x=47 —— 比铃铛中心偏左 7px，肉眼一眼能看出歪。
    -->
    <path
        android:fillColor="#37474F"
        android:pathData="M54,74 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0" />
    <!--
        右侧三条内容线：寓意「通知被整理 / 过滤」。
        V11.3 修正：原为 x=78..90（右端到圆心 39.4，超出半径 36 的安全圆 → 三条线的右端被遮罩切掉，
        且三条切口位置不同所以看着参差）。现为 x=76..85、宽 9、高 4、圆角 2，y=42/50/58 等距；
        最远点 (85,42) 到圆心 33.2 < 36，任何遮罩都不会裁到。
    -->
    <path
        android:fillColor="#37474F"
        android:pathData="M78,42 L83,42 A2,2 0 0 1 83,46 L78,46 A2,2 0 0 1 78,42 Z" />
    <path
        android:fillColor="#37474F"
        android:pathData="M78,50 L83,50 A2,2 0 0 1 83,54 L78,54 A2,2 0 0 1 78,50 Z" />
    <path
        android:fillColor="#37474F"
        android:pathData="M78,58 L83,58 A2,2 0 0 1 83,62 L78,62 A2,2 0 0 1 78,58 Z" />
</vector>
